<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.demo</groupId>
        <artifactId>swag-shop-parent</artifactId>
        <version>1.0</version>
    </parent>
    <artifactId>swag-shop-frontend</artifactId>
    <packaging>quarkus</packaging>
    <description>The shop's web pages and the API they call, which passes each request on to the services</description>

    <properties>
        <fontsource.version>5.3.0</fontsource.version>
        <rhds.version>5.0.0</rhds.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin the npm dependencies of @rhds/elements: mvnpm publishes npm version ranges,
                 which Maven cannot always resolve -->
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>lit</artifactId>
                <version>3.3.3</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>lit-element</artifactId>
                <version>4.2.2</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>lit-html</artifactId>
                <version>3.3.3</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.lit</groupId>
                <artifactId>reactive-element</artifactId>
                <version>2.1.2</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.lit</groupId>
                <artifactId>context</artifactId>
                <version>1.1.6</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.lit-labs</groupId>
                <artifactId>ssr-dom-shim</artifactId>
                <version>1.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.types</groupId>
                <artifactId>trusted-types</artifactId>
                <version>2.0.7</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>tslib</artifactId>
                <version>2.8.1</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.patternfly</groupId>
                <artifactId>pfe-core</artifactId>
                <version>6.0.0</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.rhds</groupId>
                <artifactId>icons</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm.at.rhds</groupId>
                <artifactId>tokens</artifactId>
                <version>3.2.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jfr</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-web-dependency-locator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- Red Hat Design System web components and fonts, served from mvnpm jars -->
        <dependency>
            <groupId>org.mvnpm.at.rhds</groupId>
            <artifactId>elements</artifactId>
            <version>${rhds.version}</version>
            <scope>runtime</scope>
            <exclusions>
                <!-- only used by rh-code-block, which the shop does not use -->
                <exclusion>
                    <groupId>org.mvnpm</groupId>
                    <artifactId>prism-esm</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mvnpm.at.fontsource</groupId>
            <artifactId>red-hat-display</artifactId>
            <version>${fontsource.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mvnpm.at.fontsource</groupId>
            <artifactId>red-hat-text</artifactId>
            <version>${fontsource.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mvnpm.at.fontsource</groupId>
            <artifactId>red-hat-mono</artifactId>
            <version>${fontsource.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- mvnpm serves npm packages (such as @rhds/elements) as Maven artifacts on demand -->
        <repository>
            <id>mvnpm.org</id>
            <name>mvnpm</name>
            <url>https://repo.mvnpm.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
